load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "ghclient",
    srcs = ["ghclient.go"],
    importpath = "github.com/tbhb-dev/github-metrics/internal/ghclient",
    visibility = ["//:__subpackages__"],
    deps = ["//internal/budget"],
)

go_test(
    name = "ghclient_test",
    srcs = [
        "ghclient_test.go",
        "synctest_test.go",
    ],
    visibility = ["//:__pkg__"],
    deps = [
        ":ghclient",
        "//internal/budget",
    ],
)
