load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "recorder",
    srcs = ["recorder.go"],
    importpath = "github.com/tbhb-dev/github-metrics/internal/recorder",
    visibility = ["//:__subpackages__"],
    deps = [
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

go_test(
    name = "recorder_test",
    srcs = [
        "closed_test.go",
        "export_test.go",
        "recorder_test.go",
    ],
    embed = [":recorder"],
    visibility = ["//:__pkg__"],
    deps = [
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
