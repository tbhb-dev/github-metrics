load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "reconcile",
    srcs = [
        "cibackfill.go",
        "events.go",
        "list.go",
        "loop.go",
        "run.go",
    ],
    importpath = "github.com/tbhb-dev/github-metrics/internal/reconcile",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/budget",
        "//internal/ghclient",
        "//internal/recorder",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

go_test(
    name = "reconcile_test",
    srcs = [
        "cibackfill_test.go",
        "events_test.go",
        "list_test.go",
        "loop_test.go",
        "run_test.go",
    ],
    data = glob(["testdata/**"]),
    embedsrcs = ["testdata/ci_jobs.json"],
    visibility = ["//:__pkg__"],
    deps = [
        ":reconcile",
        "//internal/budget",
        "//internal/ghclient",
        "//internal/recorder",
        "@io_opentelemetry_go_otel//attribute",
        "@io_opentelemetry_go_otel_metric//noop",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
