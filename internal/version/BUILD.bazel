load("@rules_go//go:def.bzl", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "version",
    srcs = ["version.go"],
    importpath = "github.com/tbhb-dev/github-metrics/internal/version",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "version_test",
    srcs = ["version_test.go"],
    visibility = ["//:__pkg__"],
    deps = [":version"],
    # The whole-module Go checks in the root package take the tests too.
)
