load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")
load("@tbhb_rules//repo:defs.bzl", "repo_files")

repo_files()

go_library(
    name = "github-metrics_lib",
    srcs = ["main.go"],
    importpath = "github.com/tbhb-dev/github-metrics/cmd/github-metrics",
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/receiver",
        "//internal/recorder",
        "//internal/store",
        "//internal/telemetry",
        "//internal/worker",
        "@io_opentelemetry_go_otel_metric//:metric",
    ],
)

go_binary(
    name = "github-metrics",
    embed = [":github-metrics_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "github-metrics_test",
    srcs = ["main_test.go"],
    embed = [":github-metrics_lib"],
    visibility = ["//:__pkg__"],
    deps = [
        "//internal/recorder",
        "@io_opentelemetry_go_otel_sdk_metric//:metric",
        "@io_opentelemetry_go_otel_sdk_metric//metricdata",
    ],
)
